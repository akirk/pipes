{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Pipes",
		"description": "A visual WordPress pipe builder.",
		"author": "Alex Kirk",
		"categories": [
			"Apps",
			"Automation",
			"Travel"
		]
	},
	"landingPage": "/pipes/",
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/akirk/pipes",
				"ref": "dist/main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "pipes"
			}
		}
	]
}

{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "meta": {
        "title": "Pipes",
        "description": "A visual WordPress pipe builder with Travel App abilities installed.",
        "author": "Alex Kirk",
        "categories": [
            "Apps",
            "Automation",
            "Travel"
        ]
    },
    "landingPage": "/pipes/",
    "steps": [
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/akirk/travel-app",
                "ref": "dist/add-phpunit-tests",
                "refType": "branch"
            },
            "options": {
                "activate": true,
                "targetFolderName": "travel-app"
            }
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/akirk/pipes",
                "ref": "dist/add-phpunit-tests",
                "refType": "branch"
            },
            "options": {
                "activate": true,
                "targetFolderName": "pipes"
            }
        }
    ]
}
